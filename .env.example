# Optional Firebase web configuration. These public values are already the app defaults.
# Copy to .env.local to override them; never add service account credentials here.
VITE_FIREBASE_API_KEY=AIzaSyAdevrXnZ-rfHNxXHHh-R9_aDEKzqeU1mQ
VITE_FIREBASE_AUTH_DOMAIN=secret-santa-organiser.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=secret-santa-organiser
VITE_FIREBASE_APP_ID=1:851546467900:web:e81ee0bc4d6790bffa9d39

# Local testing only. The app also requires Vite's development mode before connecting.
# Production builds ignore the emulator flag and always use the real Firebase project.
VITE_USE_EMULATORS=false

# Asset paths default to ./, supporting both the Pages repository URL and custom domain.
# Usually leave VITE_BASE_PATH unset. Set it in the command/workflow environment only
# if an explicit deployment base is needed; for example /secret_santa_organiser/ or /.
