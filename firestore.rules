rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function verified() {
      return signedIn() && request.auth.token.email_verified == true;
    }
    function isAdmin() {
      return verified() && get(/databases/$(database)/documents/config/admin).data.uid == request.auth.uid;
    }
    function eventPath(eventId) {
      return /databases/$(database)/documents/events/$(eventId);
    }
    function memberPath(eventId, uid) {
      return /databases/$(database)/documents/events/$(eventId)/members/$(uid);
    }
    function runPath(eventId, runId) {
      return /databases/$(database)/documents/events/$(eventId)/runs/$(runId);
    }
    function accessPath(authUid) {
      return /databases/$(database)/documents/participantAccess/$(authUid);
    }
    function credentialPath(eventId, memberUid) {
      return /databases/$(database)/documents/events/$(eventId)/credentials/$(memberUid);
    }
    function guestAccount() {
      return signedIn() && request.auth.token.firebase.sign_in_provider == 'password'
        && request.auth.token.email.matches('^[0-9a-f]{64}@event[.]santa[.]invalid$');
    }
    function mappedOwner(eventId, memberUid) {
      return guestAccount() && exists(accessPath(request.auth.uid))
        && get(accessPath(request.auth.uid)).data.eventId == eventId
        && get(accessPath(request.auth.uid)).data.memberUid == memberUid
        && exists(memberPath(eventId, memberUid))
        && exists(credentialPath(eventId, memberUid))
        && get(credentialPath(eventId, memberUid)).data.authUid == request.auth.uid;
    }
    function ownsMember(eventId, memberUid) {
      return (verified() && request.auth.uid == memberUid && exists(memberPath(eventId, memberUid)))
        || mappedOwner(eventId, memberUid);
    }
    function participantUid(eventId) {
      return verified() && exists(memberPath(eventId, request.auth.uid))
        ? request.auth.uid : get(accessPath(request.auth.uid)).data.memberUid;
    }
    function rosterOpen(eventId) {
      return get(eventPath(eventId)).data.status == 'open';
    }
    function canJoin(eventId) {
      return signedIn() && (verified() || guestAccount()) && rosterOpen(eventId)
        && request.time.toMillis() < get(eventPath(eventId)).data.signupDeadline;
    }
    function matchingAccessAfter(eventId, memberUid, authUid) {
      return existsAfter(accessPath(authUid))
        && getAfter(accessPath(authUid)).data.eventId == eventId
        && getAfter(accessPath(authUid)).data.memberUid == memberUid
        && existsAfter(memberPath(eventId, memberUid))
        && existsAfter(credentialPath(eventId, memberUid))
        && getAfter(credentialPath(eventId, memberUid)).data.authUid == authUid;
    }
    function canIssuePassword(eventId, memberUid) {
      return exists(memberPath(eventId, memberUid))
        && (isAdmin() || (verified() && request.auth.uid == memberUid));
    }
    function newGuestMember(eventId, memberUid, authUid) {
      return guestAccount() && request.auth.uid == authUid && memberUid == authUid
        && !exists(memberPath(eventId, memberUid)) && !exists(accessPath(authUid))
        && canJoin(eventId) && matchingAccessAfter(eventId, memberUid, authUid);
    }
    function credentialsRemoved(eventId, memberUid) {
      return !exists(credentialPath(eventId, memberUid))
        || (!existsAfter(credentialPath(eventId, memberUid))
          && !existsAfter(accessPath(get(credentialPath(eventId, memberUid)).data.authUid)));
    }
    function validEvent(d) {
      return d.keys().hasAll(['name', 'signupDeadline', 'exchangeAt', 'timezone', 'budget', 'details', 'guidelines', 'giftIdeas', 'status', 'memberCount', 'activeRunId', 'createdAt'])
        && d.keys().hasOnly(['name', 'signupDeadline', 'exchangeAt', 'timezone', 'budget', 'details', 'guidelines', 'giftIdeas', 'status', 'memberCount', 'activeRunId', 'createdAt'])
        && d.name is string && d.name.size() > 0 && d.name.size() <= 100
        && d.signupDeadline is int && d.signupDeadline > 0
        && d.exchangeAt is int && d.exchangeAt > d.signupDeadline
        && d.timezone == 'Europe/London'
        && d.budget is number && d.budget > 0 && d.budget <= 100000
        && d.details is string && d.details.size() <= 2000
        && d.guidelines is list && d.guidelines.size() <= 12
        && d.giftIdeas is list && d.giftIdeas.size() <= 20
        && d.status in ['open', 'locked', 'drawing', 'drawn', 'archived']
        && d.memberCount is int && d.memberCount >= 0
        && (d.activeRunId == null || (d.activeRunId is string && d.activeRunId.size() > 0 && d.activeRunId.size() <= 128))
        && d.createdAt is int && d.createdAt > 0;
    }
    function ownCountChange(eventId) {
      let path = memberPath(eventId, request.auth.uid);
      return canJoin(eventId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberCount'])
        && ((!exists(path) && existsAfter(path) && request.resource.data.memberCount == resource.data.memberCount + 1)
          || (ownsMember(eventId, participantUid(eventId))
            && !existsAfter(memberPath(eventId, participantUid(eventId)))
            && request.resource.data.memberCount == resource.data.memberCount - 1));
    }
    function adminEventUpdate(eventId) {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      let before = resource.data;
      let after = request.resource.data;
      return isAdmin() && (
        (changed.hasOnly(['name', 'signupDeadline', 'exchangeAt', 'timezone', 'budget', 'details', 'guidelines', 'giftIdeas'])
          && (before.status in ['open', 'locked'] || after.signupDeadline == before.signupDeadline))
        || (before.status == 'open' && changed.hasOnly(['memberCount']) && after.memberCount == before.memberCount - 1)
        || (changed.hasOnly(['status']) && before.activeRunId == null
          && ((before.status == 'open' && after.status == 'locked')
            || (before.status == 'locked' && after.status == 'open')))
        || (changed.hasOnly(['status', 'activeRunId']) && before.status == 'locked' && before.activeRunId == null
          && after.status == 'drawing' && after.memberCount >= 3 && after.activeRunId != null
          && existsAfter(runPath(eventId, after.activeRunId)))
        || (changed.hasOnly(['status']) && before.status == 'drawing' && after.status == 'drawn'
          && before.activeRunId != null)
        || (changed.hasOnly(['status']) && before.status in ['open', 'locked', 'drawn'] && after.status == 'archived')
      );
    }
    function validMember(d, uid) {
      return d.keys().hasAll(['uid', 'name', 'joinedAt']) && d.keys().hasOnly(['uid', 'name', 'joinedAt', 'preferences'])
        && d.uid == uid && d.name is string && d.name.size() > 0 && d.name.size() <= 100
        && d.joinedAt is int && d.joinedAt > 0
        && (!('preferences' in d) || (d.preferences is string && d.preferences.size() <= 500));
    }
    function isAssignedGiver(eventId, recipientUid) {
      let event = get(eventPath(eventId)).data;
      return event.status in ['drawn', 'archived'] && event.activeRunId is string
        && ownsMember(eventId, participantUid(eventId))
        && get(/databases/$(database)/documents/events/$(eventId)/runs/$(event.activeRunId)/assignments/$(participantUid(eventId))).data.recipientUid == recipientUid;
    }
    function preferencesEditable(eventId) {
      return get(eventPath(eventId)).data.status in ['open', 'locked', 'drawing', 'drawn']
        && getAfter(eventPath(eventId)).data.status in ['open', 'locked', 'drawing', 'drawn'];
    }

    // Provision the sole organiser from the console or a trusted setup script.
    match /config/admin {
      allow get: if signedIn();
      allow list, write: if false;
    }

    // Access records map event-password accounts to immutable participant IDs.
    // Existing members and published assignments keep their original IDs.
    match /participantAccess/{authUid} {
      allow get: if signedIn() && (request.auth.uid == authUid || isAdmin());
      allow list, update: if false;
      allow create: if signedIn()
        && request.resource.data.keys().hasAll(['eventId', 'memberUid'])
        && request.resource.data.keys().hasOnly(['eventId', 'memberUid'])
        && request.resource.data.eventId is string && request.resource.data.eventId.matches('^[^/]{1,128}$')
        && request.resource.data.memberUid is string && request.resource.data.memberUid.matches('^[^/]{1,128}$')
        && !exists(credentialPath(request.resource.data.eventId, request.resource.data.memberUid))
        && matchingAccessAfter(request.resource.data.eventId, request.resource.data.memberUid, authUid)
        && (canIssuePassword(request.resource.data.eventId, request.resource.data.memberUid)
          || newGuestMember(request.resource.data.eventId, request.resource.data.memberUid, authUid));
      allow delete: if signedIn()
        && (isAdmin() || ownsMember(resource.data.eventId, resource.data.memberUid))
        && !existsAfter(memberPath(resource.data.eventId, resource.data.memberUid))
        && !existsAfter(credentialPath(resource.data.eventId, resource.data.memberUid));
    }

    match /events/{eventId} {
      allow read: if true;
      allow create: if isAdmin() && validEvent(request.resource.data)
        && request.resource.data.status == 'open'
        && request.resource.data.memberCount == 0 && request.resource.data.activeRunId == null;
      allow update: if validEvent(request.resource.data)
        && ((signedIn() && ownCountChange(eventId)) || adminEventUpdate(eventId));
      allow delete: if false;

      match /members/{uid} {
        allow get: if signedIn() && ((verified() && request.auth.uid == uid)
          || (guestAccount() && request.auth.uid == uid && !exists(memberPath(eventId, uid)))
          || mappedOwner(eventId, uid) || isAdmin() || isAssignedGiver(eventId, uid));
        allow list: if isAdmin();
        allow create: if canJoin(eventId) && request.auth.uid == uid
          && (verified() || newGuestMember(eventId, uid, request.auth.uid))
          && validMember(request.resource.data, uid)
          && getAfter(eventPath(eventId)).data.memberCount == get(eventPath(eventId)).data.memberCount + 1
          && getAfter(eventPath(eventId)).data.status == 'open';
        allow update: if ownsMember(eventId, uid)
          && validMember(request.resource.data, uid)
          && ((canJoin(eventId)
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'preferences'])
              && getAfter(eventPath(eventId)).data.status == 'open')
            || (preferencesEditable(eventId)
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['preferences'])));
        allow delete: if ((canJoin(eventId) && ownsMember(eventId, uid)) || (isAdmin() && rosterOpen(eventId)))
          && getAfter(eventPath(eventId)).data.memberCount == get(eventPath(eventId)).data.memberCount - 1
          && getAfter(eventPath(eventId)).data.status == 'open'
          && credentialsRemoved(eventId, uid);
      }

      // Recoverable passwords never appear in the member records read by givers.
      match /credentials/{memberUid} {
        allow get: if isAdmin() || ownsMember(eventId, memberUid);
        allow list, update: if false;
        allow create: if signedIn()
          && request.resource.data.keys().hasAll(['authUid', 'password', 'createdAt'])
          && request.resource.data.keys().hasOnly(['authUid', 'password', 'createdAt'])
          && request.resource.data.authUid is string && request.resource.data.authUid.matches('^[^/]{1,128}$')
          && request.resource.data.password is string && request.resource.data.password.size() >= 16
          && request.resource.data.password.size() <= 128
          && request.resource.data.createdAt is int && request.resource.data.createdAt > 0
          && !exists(accessPath(request.resource.data.authUid))
          && matchingAccessAfter(eventId, memberUid, request.resource.data.authUid)
          && (canIssuePassword(eventId, memberUid)
            || newGuestMember(eventId, memberUid, request.resource.data.authUid));
        allow delete: if (isAdmin() || ownsMember(eventId, memberUid))
          && !existsAfter(memberPath(eventId, memberUid))
          && !existsAfter(accessPath(resource.data.authUid));
      }

      match /runs/{runId} {
        allow read: if isAdmin();
        allow create: if isAdmin()
          && get(eventPath(eventId)).data.status == 'locked'
          && getAfter(eventPath(eventId)).data.status == 'drawing'
          && getAfter(eventPath(eventId)).data.activeRunId == runId
          && request.resource.data.keys().hasAll(['members', 'recipients', 'count', 'createdAt'])
          && request.resource.data.keys().hasOnly(['members', 'recipients', 'count', 'createdAt'])
          && request.resource.data.members is map && request.resource.data.recipients is map
          && request.resource.data.count is int && request.resource.data.count >= 3
          && request.resource.data.count == get(eventPath(eventId)).data.memberCount
          && request.resource.data.members.size() == request.resource.data.count
          && request.resource.data.recipients.size() == request.resource.data.count
          && request.resource.data.members.keys().hasAll(request.resource.data.recipients.keys())
          && request.resource.data.createdAt is int;
        allow update, delete: if false;

        match /assignments/{uid} {
          function published() {
            let event = get(eventPath(eventId)).data;
            return event.status in ['drawn', 'archived'] && event.activeRunId == runId;
          }
          function plannedAssignment() {
            let plan = get(runPath(eventId, runId)).data;
            let d = request.resource.data;
            return d.keys().hasAll(['giverUid', 'recipientUid', 'recipientName'])
              && d.keys().hasOnly(['giverUid', 'recipientUid', 'recipientName'])
              && d.giverUid == uid && d.recipientUid is string && d.recipientUid != uid
              && uid in plan.members && d.recipientUid in plan.members
              && d.recipientUid == plan.recipients[uid]
              && d.recipientName == plan.members[d.recipientUid];
          }
          allow get: if isAdmin() || (ownsMember(eventId, uid) && published());
          allow list: if isAdmin();
          allow create: if isAdmin() && get(eventPath(eventId)).data.status == 'drawing'
            && get(eventPath(eventId)).data.activeRunId == runId && plannedAssignment();
          // Identical retries are harmless, even if another tab has just published.
          allow update: if isAdmin() && request.resource.data == resource.data;
          allow delete: if false;
        }
      }
    }
  }
}
